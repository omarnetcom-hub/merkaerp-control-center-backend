# Required database / administrator secrets
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
ADMIN_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
DB_CREDENTIAL_SECRET=replace-with-a-different-random-secret-at-least-32-bytes

# MerkaERP 1.2.1+5 publisher signing authority (RS256).
# IMPORTANT: this MUST be the EXISTING private key whose public-key SPKI SHA-256 is:
# e3344e9f2e3010c75fcbd64d7bb8f4ddc34eedc5a18f7296b82d914e5df2fb27
# Do not generate/rotate this key unless MerkaERP is intentionally rebuilt with a new pinned public key.
# Configure ONE of the following:
JWT_PRIVATE_KEY_PEM=
JWT_PRIVATE_KEY_BASE64=base64-encoded-existing-rsa-private-key-pem
JWT_PRIVATE_KEY_PATH=
# Optional matching public key; normally derived from the private key.
JWT_PUBLIC_KEY_PEM=
JWT_PUBLIC_KEY_BASE64=
JWT_PUBLIC_KEY_PATH=

# First boot only. Remove after the first super-admin is created.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-14-characters
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_NAME=Administrador

# Optional hardening/configuration
JWT_ISSUER=merka-control-center
ADMIN_JWT_AUDIENCE=merka-control-center-admin
ADMIN_TOKEN_TTL=8h
ADMIN_ALLOWED_ORIGINS=
REMOTE_ACCESS_ENABLED=false
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
PORT=8787
NODE_ENV=production

# Managed release artifacts. In production this directory MUST be backed by
# persistent storage (for example a Render Persistent Disk) or releases will
# disappear when the instance is replaced.
PUBLIC_BASE_URL=https://your-control-center-backend.example.com
RELEASE_STORAGE_DIR=./release_storage
RELEASE_UPLOAD_LIMIT=536870912

# Remote desktop itself is provider/agent-driven. Keep false until MerkaERP has
# a compatible consent + transport adapter installed.
