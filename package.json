{
  "name": "merka-control-center-backend",
  "version": "1.2.1",
  "description": "Backend para Merka Control Center",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:check": "node scripts/db-check.js",
    "license:seed": "node scripts/seed-license-smoke.js",
    "license:smoke": "node scripts/license-endpoint-smoke.js",
    "secrets:generate": "node scripts/generate-secrets.js",
    "check": "node --check src/server.js && node scripts/contract-selfcheck.js",
    "admin:create": "node scripts/create-admin.js",
    "publisher:check": "node scripts/check-publisher-key.js",
    "selfcheck": "node scripts/contract-selfcheck.js",
    "verify:deployment": "node scripts/verify-deployment.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.3.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
